[Desktop Entry]
Name=Unboxing
Comment=Install apps downloaded from the Internet
GenericName=Package Installer
Exec=@APP_ID@ %u
Icon=@APP_ID@
Keywords=package;apt;dpkg;install;rpm;deb;debian
SingleMainWindow=false
Terminal=false
Type=Application
StartupNotify=true
Categories=System;PackageManager;
MimeType=application/x-deb;application/vnd.debian.binary-package;
X-GNOME-UsesNotifications=true
